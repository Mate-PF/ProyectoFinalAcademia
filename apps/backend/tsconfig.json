{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*"],
  "//": "Los adaptadores Prisma se ejecutan vía tsx (dependen del cliente generado); se excluyen del typecheck por defecto.",
  "exclude": ["src/adapters/prisma/**"]
}
