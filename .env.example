# Variables para Docker Compose. Copiá este archivo a `.env` (no se versiona):
#   cp .env.example .env
#
# Compose lee `./.env` automáticamente para (1) interpolar ${VARS} en el
# docker-compose.yml y (2) inyectarlas en los servicios vía `env_file`.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pedidos

# --- Backend ---
# En producción de verdad, poné un secreto largo y aleatorio (y nunca lo commitees).
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio
