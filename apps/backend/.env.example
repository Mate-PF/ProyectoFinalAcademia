# Copiar a .env y ajustar. La DB se levanta con `docker compose up -d` desde la raíz.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pedidos?schema=public"
JWT_SECRET="dev-secret-change-me"
# Persistencia: "memory" (default, sin DB) o "prisma" (requiere DB + prisma generate + migrate).
PERSISTENCE="memory"
PORT=3000
